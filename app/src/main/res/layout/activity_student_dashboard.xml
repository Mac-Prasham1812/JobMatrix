<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_screen"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="12dp"
        android:paddingBottom="22dp">
        <!--        android:background="@color/color_surface"-->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Morning"
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="User"
                android:textColor="@color/color_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSavedJobs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:contentDescription="Saved Jobs"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/color_text_secondary" />

        <ImageView
            android:id="@+id/ivSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/color_text_secondary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/completenessCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ProgressBar
                    android:id="@+id/pbCompleteness"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="65"
                    android:progressDrawable="@drawable/progress_ring_completeness"
                    android:rotation="-90" />

                <TextView
                    android:id="@+id/tvCompletenessPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="65%"
                    android:textColor="@color/color_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCompletenessTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complete your profile"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompletenessMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvCompletenessTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add your phone number to reach 100%"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCompletenessAction"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/color_text_hint" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:text="Your application pipeline"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- APPLICATION PIPELINE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pipeline_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_circle_blue"
                android:padding="7dp"
                android:src="@drawable/ic_document" />

            <TextView
                android:id="@+id/tvAppliedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/color_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applied"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pipeline_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_circle_orange"
                android:padding="7dp"
                android:src="@drawable/ic_eye" />

            <TextView
                android:id="@+id/tvInReviewCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F59E0B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Review"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pipeline_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_circle_green"
                android:padding="7dp"
                android:src="@drawable/ic_check" />

            <TextView
                android:id="@+id/tvShortlistedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#16A34A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shortlisted"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!--    <LinearLayout-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:orientation="horizontal"-->
    <!--        android:paddingHorizontal="16dp"-->
    <!--        android:paddingTop="12dp"-->
    <!--        android:gravity="center_vertical">-->

    <!--        <TextView-->
    <!--            android:layout_width="0dp"-->
    <!--            android:layout_height="wrap_content"-->
    <!--            android:layout_weight="1"-->
    <!--            android:text="Matched for you"-->
    <!--            android:textSize="14sp"-->
    <!--            android:textStyle="bold"-->
    <!--            android:textColor="@color/color_text_primary"/>-->

    <!--        <TextView-->
    <!--            android:id="@+id/tvViewAll"-->
    <!--            android:layout_width="wrap_content"-->
    <!--            android:layout_height="wrap_content"-->
    <!--            android:text="View all"-->
    <!--            android:textSize="13sp"-->
    <!--            android:textColor="@color/color_accent"/>-->
    <!--    </LinearLayout>-->

    <!-- SHIMMER JOB LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShimmer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:saveEnabled="false"
        android:visibility="visible" />

    <!-- JOB LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingBottom="80dp"
        android:saveEnabled="false"
        android:visibility="gone" />

    <!-- BOTTOM NAVBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/color_surface"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:duplicateParentState="true"
                android:src="@drawable/home"
                app:tint="@color/nav_icon_selector" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Home"
                android:textColor="@color/nav_icon_selector"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:duplicateParentState="true"
                android:src="@drawable/search"
                app:tint="@color/nav_icon_selector" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Search"
                android:textColor="@color/nav_icon_selector"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/ivNotification"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/notification"
                    app:tint="@color/nav_icon_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Notifications"
                    android:textColor="@color/nav_icon_selector"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotificationBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_badge_red"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_chat_empty"
                    app:tint="@color/nav_icon_selector" />

                <TextView
                    android:id="@+id/tvChatsBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Chats"
                android:textColor="@color/nav_icon_selector"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavProfileDefault"
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:duplicateParentState="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/profile"
                    app:tint="@color/nav_icon_selector" />

                <ImageView
                    android:id="@+id/ivNavProfilePhoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_avatar_ring"
                    android:duplicateParentState="true"
                    android:padding="1.5dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="Profile"
                android:textColor="@color/nav_icon_selector"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>